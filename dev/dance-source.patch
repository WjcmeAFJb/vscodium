diff --git a/src/utils/fast-path.ts b/src/utils/fast-path.ts
new file mode 100644
index 0000000..58b9ec7
--- /dev/null
+++ b/src/utils/fast-path.ts
@@ -0,0 +1,64 @@
+// Fast-path detection for the Dance bundle when running inside VSCodium
+// patched with `src/vs/workbench/contrib/dance/`.
+//
+// The renderer-side contribution exposes a few `_dance.*` commands that
+// short-circuit hot paths (mode flips, regex search, atomic edits) that
+// would otherwise cost an extension-host round-trip per call. When dance
+// runs inside an unpatched VS Code/VSCodium the commands are absent and
+// we transparently fall back to the regular vscode API.
+//
+// We probe once at activation and cache the result so the per-call check
+// is a plain boolean read.
+
+import * as vscode from "vscode";
+
+const FAST_COMMANDS = [
+  "_dance.setMode",
+  "_dance.atomicEdit",
+  "_dance.regex.exec",
+  "_dance.pushSelections",
+  "_dance.popSelections",
+] as const;
+
+let _hasFastPaths: boolean | undefined;
+let _probePromise: Promise<boolean> | undefined;
+
+/** Resolve once whether the renderer-side contribution is present. */
+export function probeFastPaths(): Promise<boolean> {
+  if (_hasFastPaths !== undefined) {
+    return Promise.resolve(_hasFastPaths);
+  }
+  if (_probePromise !== undefined) {
+    return _probePromise;
+  }
+  _probePromise = vscode.commands.getCommands(true).then((all) => {
+    const set = new Set(all);
+    const ok = FAST_COMMANDS.every((c) => set.has(c));
+    _hasFastPaths = ok;
+    return ok;
+  }, () => {
+    _hasFastPaths = false;
+    return false;
+  });
+  return _probePromise;
+}
+
+/** Synchronous read after probing has resolved. Defaults to `false` while pending. */
+export function hasFastPaths(): boolean {
+  return _hasFastPaths === true;
+}
+
+/** Set the dance mode context key, preferring the renderer fast path when available. */
+export function setModeContext(modeName: string | undefined): Thenable<unknown> {
+  if (_hasFastPaths === true && typeof modeName === "string") {
+    return vscode.commands.executeCommand("_dance.setMode", modeName);
+  }
+  return vscode.commands.executeCommand("setContext", "dance.mode", modeName);
+}
+
+/** Set the recording context key, preferring the renderer fast path when available. */
+export function setRecordingContext(recording: boolean): Thenable<unknown> {
+  // No dedicated fast path for `dance.isRecording` yet; the cost of a single
+  // per-recording-toggle ext-host hop is negligible. Forwarding for symmetry.
+  return vscode.commands.executeCommand("setContext", "dance.isRecording", recording);
+}
